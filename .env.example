# Postgres (Neon sa-east-1 em produção; local: qualquer Postgres)
DATABASE_URL=postgres://usuario:senha@localhost:5432/escala
# 32+ caracteres aleatórios (ex.: openssl rand -base64 48)
SESSION_SECRET=
# Web Push (gere com: pnpm vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@exemplo.com
# Mesmo valor de VAPID_PUBLIC_KEY (exposto ao navegador)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Segredo dos crons de lembretes e limpeza (Vercel envia como Bearer)
CRON_SECRET=
# Controladora dos dados (política de privacidade e termos). Vazio = "a informar".
IGREJA_NOME="Lagoinha Mogi das Cruzes"
IGREJA_CNPJ="47.919.179/0001-49"
IGREJA_ENDERECO="Rua Dr. Deodato Wertheimer, 848 - Vila Mogilar, Mogi das Cruzes - SP"
# Canal de pedidos do titular (atendido pela PI System em nome da igreja)
IGREJA_CONTATO="contato@pi-system.com"
