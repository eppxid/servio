# Postgres (Neon sa-east-1 em produção; local: qualquer Postgres)
DATABASE_URL=postgres://usuario:senha@localhost:5432/escala
# 32+ caracteres aleatórios (ex.: openssl rand -base64 48)
SESSION_SECRET=
# Web Push (gere com: pnpm vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@exemplo.com
# Mesmo valor de VAPID_PUBLIC_KEY (exposto ao navegador)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Segredo do cron de lembretes (Vercel envia como Bearer)
CRON_SECRET=
